[Unit]
Description=Onshape -> Bambu Studio bridge
After=network.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/onshape-bambu-bridge/server
ExecStart=%h/.local/bin/uv run --script %h/.local/share/onshape-bambu-bridge/server/main.py
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
